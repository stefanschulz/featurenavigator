<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         stopOnFailure="false"
         failOnRisky="true"
         failOnWarning="true"
         verbose="true">
    <testsuites>
        <testsuite name="Unit"><directory suffix="Test.php">./tests/Unit</directory></testsuite>
        <testsuite name="Integration"><directory suffix="Test.php">./tests/Integration</directory></testsuite>
    </testsuites>
    <php>
        <!-- Adjust PS_ROOT_DIR if CI runs from a different location -->
        <env name="PS_ROOT_DIR" value="../.."/>
    </php>
</phpunit>
